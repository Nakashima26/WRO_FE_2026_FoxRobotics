[Unit]
Description=FoxRobotics WRO runtime
After=network-online.target dev-serial0.device
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/FoxRobotics
ExecStart=/home/user/FoxRobotics/.venv/bin/python /home/user/FoxRobotics/src/RASPI/cam/pure_pursuit/runtime_nuevo.py --cam-index 0 --serial-port /dev/serial0 --threaded-capture --record-orillas --record-output /home/user/FoxRobotics/videos_orillas
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
